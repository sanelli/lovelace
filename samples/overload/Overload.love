{ Same-name procedures overload by parameter types (return type ignored).
  true → boolean; 42s32 → integer (bare 42 is Ambiguous_Call vs integer<8>);
  1s8 → integer<8>. }
module Overload;
procedure Sink(Value : integer);
begin
end;
procedure Sink(Flag : boolean);
begin
end;
procedure Sink(Byte : integer<8>);
begin
end;
procedure Run();
begin
   Overload.Sink(42s32);
   Overload.Sink(true);
   Overload.Sink(1s8);
end;
end.
