{ Same-name procedures overload by parameter types (return type ignored).
  Bare 42 / true select integer vs boolean. Width overloads use suffixes:
  1s8 → integer<8>; bare 1 would be Ambiguous_Call against integer + integer<8>. }
module Overload;
procedure Sink(Value : integer);
begin
end;
procedure Sink(Flag : boolean);
begin
end;
procedure Sink(Byte : integer<8>);
begin
end;
procedure Run();
begin
   Overload.Sink(42);
   Overload.Sink(true);
   Overload.Sink(1s8);
end;
end.
