with "config/lovelace_common_config.gpr";
with "../shared/lovelace_host_switches.gpr";
library project Lovelace_Common is

   for Library_Name use "lovelace_common";
   for Library_Kind use "static";
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lovelace_Common_Config.Build_Profile;
   for Library_Dir use "lib/" & Lovelace_Common_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Lovelace_Common_Config.Ada_Compiler_Switches
        & Lovelace_Host_Switches.Ada_Compiler_Switches;
   end Compiler;

end Lovelace_Common;
