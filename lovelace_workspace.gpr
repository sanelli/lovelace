with "config/lovelace_workspace_config.gpr";
aggregate project Lovelace_Workspace is

   for Project_Files use
     ("lovelace/lovelace/lovelace.gpr",
      "lovelace/common/lovelace_common.gpr",
      "lovelace/compiler/lovelace_compiler.gpr",
      "lovelace/lir/lovelace_lir.gpr");

end Lovelace_Workspace;
