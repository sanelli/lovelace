with "config/lovelace_config.gpr";
with "../shared/lovelace_host_switches.gpr";
project Lovelace is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lovelace_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("lovelace.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Lovelace_Config.Ada_Compiler_Switches
        & Lovelace_Host_Switches.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Documentation is
      for Output_Dir use "gnatdoc";
   end Documentation;

end Lovelace;
